<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: reminders, permissions, maintenance, demo mode, about. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:navigationContentDescription="@string/settings_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_l">

            <!-- Reminders -->
            <TextView
                android:id="@+id/sectionReminders"
                style="@style/Widget.Nearlist.SettingsSection"
                android:text="@string/settings_section_reminders" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_xs">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications_paused" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cooldownTitle"
                        style="@style/Widget.Nearlist.SettingsTitle"
                        android:text="@string/settings_cooldown_title" />

                    <TextView
                        style="@style/Widget.Nearlist.SettingsBody"
                        android:text="@string/settings_cooldown_body" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cooldown options; MaterialRadioButtons kept exclusive in SettingsActivity. -->
            <LinearLayout
                android:id="@+id/cooldownOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_s"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/cooldown1"
                    style="@style/Widget.Nearlist.SettingsRadio"
                    tools:text="1 hour" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/cooldown4"
                        style="@style/Widget.Nearlist.SettingsRadio"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        tools:text="4 hours" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/shape_rounded_8"
                        android:backgroundTint="?attr/colorSecondaryContainer"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="@dimen/space_s"
                        android:text="@string/settings_default_badge"
                        android:textAppearance="@style/TextAppearance.Nearlist.LabelMedium"
                        android:textColor="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/cooldown8"
                    style="@style/Widget.Nearlist.SettingsRadio"
                    tools:text="8 hours" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/cooldown24"
                    style="@style/Widget.Nearlist.SettingsRadio"
                    tools:text="24 hours" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="@dimen/space_m" />

            <LinearLayout
                android:id="@+id/batteryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_battery_saver" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Nearlist.SettingsTitle"
                        android:text="@string/settings_battery_title" />

                    <TextView
                        style="@style/Widget.Nearlist.SettingsBody"
                        android:text="@string/settings_battery_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/batterySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_battery_title"
                    app:thumbIcon="@drawable/switch_thumb_icon" />
            </LinearLayout>

            <!-- Permissions -->
            <TextView
                android:id="@+id/sectionPermissions"
                style="@style/Widget.Nearlist.SettingsSection"
                android:text="@string/settings_section_permissions" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_m"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/locationRow"
                        layout="@layout/item_settings_permission" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/backgroundRow"
                        layout="@layout/item_settings_permission" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/notificationsRow"
                        layout="@layout/item_settings_permission" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/settings_open_android_settings"
                android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_open_in_new_small"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <!-- Maintenance -->
            <TextView
                android:id="@+id/sectionMaintenance"
                style="@style/Widget.Nearlist.SettingsSection"
                android:paddingTop="@dimen/space_l"
                android:text="@string/settings_section_maintenance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sync" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Nearlist.SettingsTitle"
                        android:text="@string/settings_zones_title" />

                    <TextView
                        style="@style/Widget.Nearlist.SettingsBody"
                        android:text="@string/settings_zones_body" />

                    <TextView
                        android:id="@+id/zonesStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="7 zones · last registered today, 7:58 AM" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reregister"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_reregister"
                        app:icon="@drawable/ic_sync" />
                </LinearLayout>
            </LinearLayout>

            <!-- Developer · Demo mode (dashed container) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_m"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/shape_dashed_outline_16"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingTop="12dp"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/settings_section_developer"
                    android:textAppearance="@style/TextAppearance.Nearlist.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_science_small"
                    app:drawableTint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/demoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Nearlist.SettingsTitle"
                            android:text="@string/settings_demo_title" />

                        <TextView
                            style="@style/Widget.Nearlist.SettingsBody"
                            android:text="@string/settings_demo_body" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/demoSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_demo_title"
                        app:thumbIcon="@drawable/switch_thumb_icon" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/settings_demo_note"
                    android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- About -->
            <TextView
                android:id="@+id/sectionAbout"
                style="@style/Widget.Nearlist.SettingsSection"
                android:paddingTop="@dimen/space_l"
                android:text="@string/settings_section_about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Nearlist.SettingsTitle"
                        android:text="@string/settings_version_title" />

                    <TextView
                        android:id="@+id/version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.Nearlist.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        tools:text="1.0 (build 1)" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_cloud_off" />

                <TextView
                    style="@style/Widget.Nearlist.SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/settings_offline" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/licencesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_description" />

                <TextView
                    style="@style/Widget.Nearlist.SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/settings_licences" />

                <ImageView
                    style="@style/Widget.Nearlist.SettingsIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
