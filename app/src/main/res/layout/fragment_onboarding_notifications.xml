<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <!-- Illustration (screen 04): bell and a sample grouped reminder. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:importantForAccessibility="noHideDescendants"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="-50dp"
                    android:alpha="0.15"
                    android:src="@drawable/shape_ring"
                    app:tint="?attr/colorTertiary" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="-10dp"
                    android:alpha="0.25"
                    android:src="@drawable/shape_ring"
                    app:tint="?attr/colorTertiary" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="30dp"
                    android:alpha="0.4"
                    android:src="@drawable/shape_ring"
                    app:tint="?attr/colorTertiary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="60dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications_active_filled"
                        app:tint="?attr/colorOnTertiaryContainer" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="14dp"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/shape_circle"
                                android:backgroundTint="@color/category_grocery"
                                android:padding="3dp"
                                android:src="@drawable/ic_stat_nearlist"
                                app:tint="?attr/colorSurfaceContainerLowest" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/onboarding_notifications_mock_header"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/space_xs">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/onboarding_notifications_mock_title"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/onboarding_notifications_mock_text"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <ImageView
                                android:importantForAccessibility="no"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/shape_rounded_8"
                                android:backgroundTint="@color/category_grocery_container"
                                android:padding="6dp"
                                android:src="@drawable/ic_category_grocery"
                                app:tint="@color/category_grocery" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp">

                            <TextView
                                style="@style/Widget.Nearlist.OnboardingMockAction"
                                android:text="@string/notification_action_mark_all_done" />

                            <TextView
                                style="@style/Widget.Nearlist.OnboardingMockAction"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/notification_action_snooze" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/onboarding_notifications_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_notifications_body"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_l" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/allowNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_notifications_action"
            app:icon="@drawable/ic_notifications"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/onboarding_notifications_skip" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
