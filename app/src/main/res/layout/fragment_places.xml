<?xml version="1.0" encoding="utf-8"?>
<!-- Places tab (screens 11 list, 12 overflow menu, 13 empty). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/placeList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_place" />

    <!-- Empty state (screen 13). -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="220dp"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginStart="30dp"
                    android:alpha="0.25"
                    android:importantForAccessibility="no"
                    android:src="@drawable/shape_ring_dashed"
                    app:tint="?attr/colorPrimary" />

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="40dp"
                    android:alpha="0.3"
                    android:importantForAccessibility="no"
                    android:src="@drawable/shape_circle"
                    app:tint="?attr/colorPrimaryContainer" />

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="40dp"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:src="@drawable/shape_ring"
                    app:tint="?attr/colorPrimary" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="108dp"
                    android:layout_marginTop="78dp"
                    android:background="@drawable/shape_rounded_12"
                    android:backgroundTint="?attr/colorPrimary"
                    android:elevation="3dp"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_storefront"
                    app:tint="?attr/colorOnPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="128dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_directions_walk_filled"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="214dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/shape_rounded_8"
                    android:backgroundTint="@color/category_grocery_container"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_category_grocery"
                    app:tint="@color/category_grocery" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="236dp"
                    android:layout_marginTop="104dp"
                    android:background="@drawable/shape_rounded_8"
                    android:backgroundTint="@color/category_fuel_container"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_category_fuel"
                    app:tint="@color/category_fuel" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="196dp"
                    android:layout_marginTop="176dp"
                    android:background="@drawable/shape_rounded_8"
                    android:backgroundTint="@color/category_pharmacy_container"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_category_pharmacy"
                    app:tint="@color/category_pharmacy" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/shape_rounded_8"
                    android:backgroundTint="@color/category_other_container"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_category_other"
                    app:tint="@color/category_other" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/places_empty_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:maxWidth="300dp"
                android:text="@string/places_empty_body"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/shape_rounded_12"
                android:backgroundTint="?attr/colorSurfaceContainer"
                android:drawablePadding="12dp"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="12dp"
                android:text="@string/places_empty_tip"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_tips"
                app:drawableTint="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyAddPlace"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/places_add"
                app:icon="@drawable/ic_add_location" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addPlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:text="@string/places_add"
        android:visibility="gone"
        app:icon="@drawable/ic_add_location"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
