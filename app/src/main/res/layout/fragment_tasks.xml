<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks tab (banner, list, empty). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.sharma.nearlist.ui.common.StatusBanner
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xs"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/listContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:contentDescription="@string/tasks_filter_description"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_xs"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/filterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checkedChip="@id/chipAll"
                        app:chipSpacingHorizontal="@dimen/space_s"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tasks_filter_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGrocery"
                            style="@style/Widget.Nearlist.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_grocery"
                            app:chipIcon="@drawable/ic_category_grocery"
                            app:chipIconTint="@color/category_grocery" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFuel"
                            style="@style/Widget.Nearlist.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_fuel"
                            app:chipIcon="@drawable/ic_category_fuel"
                            app:chipIconTint="@color/category_fuel" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPharmacy"
                            style="@style/Widget.Nearlist.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_pharmacy"
                            app:chipIcon="@drawable/ic_category_pharmacy"
                            app:chipIconTint="@color/category_pharmacy" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipOther"
                            style="@style/Widget.Nearlist.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_other"
                            app:chipIcon="@drawable/ic_category_other"
                            app:chipIconTint="@color/category_other" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:minHeight="20dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/sortIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_near_me"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/sortLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/tasks_sort_nearest"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/openCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="4 open" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/taskList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingTop="12dp"
                    android:paddingBottom="96dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_task" />
            </LinearLayout>

            <!-- Empty state. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="96dp">

                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="200dp"
                        android:importantForAccessibility="noHideDescendants">

                        <ImageView
                            android:layout_width="240dp"
                            android:layout_height="240dp"
                            android:layout_marginTop="-20dp"
                            android:alpha="0.12"
                            android:importantForAccessibility="no"
                            android:src="@drawable/shape_ring"
                            app:tint="?attr/colorPrimary" />

                        <ImageView
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_marginStart="40dp"
                            android:layout_marginTop="20dp"
                            android:alpha="0.2"
                            android:importantForAccessibility="no"
                            android:src="@drawable/shape_ring"
                            app:tint="?attr/colorPrimary" />

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="80dp"
                            android:layout_marginTop="60dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/shape_circle"
                            app:tint="?attr/colorPrimaryContainer" />

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="96dp"
                            android:layout_marginTop="72dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_pin_filled"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="104dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="132dp"
                            android:layout_marginTop="112dp"
                            android:background="@drawable/shape_card_dashed"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/shape_checkbox_outline"
                                    app:tint="?attr/colorOutlineVariant" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="6dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shape_pill"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginTop="@dimen/space_s"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/shape_checkbox_outline"
                                    app:tint="?attr/colorOutlineVariant" />

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="6dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/shape_pill"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="40dp"
                            android:background="@drawable/shape_rounded_8"
                            android:backgroundTint="@color/category_grocery_container"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:src="@drawable/ic_category_grocery"
                            app:tint="@color/category_grocery" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="136dp"
                            android:background="@drawable/shape_rounded_8"
                            android:backgroundTint="@color/category_fuel_container"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:src="@drawable/ic_category_fuel"
                            app:tint="@color/category_fuel" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="176dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/shape_rounded_8"
                            android:backgroundTint="@color/category_pharmacy_container"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:src="@drawable/ic_category_pharmacy"
                            app:tint="@color/category_pharmacy" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:gravity="center"
                        android:text="@string/tasks_empty_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center"
                        android:maxWidth="296dp"
                        android:text="@string/tasks_empty_body"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/space_m"
                            android:paddingVertical="@dimen/space_s">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="56dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/shape_circle"
                                    android:backgroundTint="?attr/colorPrimary"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text="@string/tasks_empty_step1_number"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnPrimary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_m"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tasks_empty_step1_title"
                                        android:textAppearance="?attr/textAppearanceTitleMedium"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tasks_empty_step1_body"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="56dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/shape_number_outline"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text="@string/tasks_empty_step2_number"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_m"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tasks_empty_step2_title"
                                        android:textAppearance="?attr/textAppearanceTitleMedium"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tasks_empty_step2_body"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/savePlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/tasks_empty_action"
                        app:icon="@drawable/ic_add_location"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:text="@string/tasks_add"
        app:icon="@drawable/ic_add_task" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
