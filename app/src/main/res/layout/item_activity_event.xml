<?xml version="1.0" encoding="utf-8"?>
<!-- One Activity log event on the day's timeline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/time"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:importantForAccessibility="no"
        android:paddingTop="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.Nearlist.LabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="6:42 PM" />

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="noHideDescendants">

        <!-- Timeline: above the tile (hidden on a day's first event), below it (hidden on the last). -->
        <View
            android:id="@+id/lineTop"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal|top"
            android:background="?attr/colorOutlineVariant" />

        <View
            android:id="@+id/lineBottom"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutlineVariant" />

        <ImageView
            android:id="@+id/tile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/shape_rounded_8"
            android:importantForAccessibility="no"
            android:padding="6dp"
            tools:backgroundTint="@color/category_grocery_container"
            tools:src="@drawable/ic_category_grocery"
            tools:tint="@color/category_grocery" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Nearlist.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Keells Kalutara" />

            <TextView
                android:id="@+id/simulated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/shape_label_simulated"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/activity_simulated"
                android:textAppearance="@style/TextAppearance.Nearlist.LabelMedium"
                android:textColor="?attr/colorTertiary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Entered · Grocery" />

        <LinearLayout
            android:id="@+id/outcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_rounded_8"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/outcomeIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_check_circle_filled" />

            <TextView
                android:id="@+id/outcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="@style/TextAppearance.Nearlist.LabelMedium"
                tools:text="Notified · 3 tasks" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
