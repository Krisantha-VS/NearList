<?xml version="1.0" encoding="utf-8"?>
<!-- Category header in the Places list: icon, label, count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_s"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_xs">

    <ImageView
        android:id="@+id/headerIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurface"
        tools:src="@drawable/ic_category_grocery" />

    <TextView
        android:id="@+id/headerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Nearlist.LabelLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Grocery" />

    <TextView
        android:id="@+id/headerCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="3" />
</LinearLayout>
