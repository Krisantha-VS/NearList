<?xml version="1.0" encoding="utf-8"?>
<!-- Reminder zones summary card at the top of the Places list. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_rounded_12"
                android:backgroundTint="?attr/colorPrimary"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_zones"
                app:tint="?attr/colorOnPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/placeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nearlist.TitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="7 places" />

                <TextView
                    android:id="@+id/zonesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nearlist.BodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="7 of 100 active reminder zones" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/zonesProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/places_zones_progress"
            android:max="100"
            app:indicatorColor="?attr/colorPrimary"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            tools:progress="7" />

        <TextView
            android:id="@+id/zonesCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Nearlist.BodySmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="Android allows each app up to 100 zones." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
