<?xml version="1.0" encoding="utf-8"?>
<!-- Completed task row (screen 06, "Completed" section): greyed, struck through, tap the box to reopen. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <ImageView
            android:id="@+id/categoryTile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_rounded_12"
            android:backgroundTint="?attr/colorSurfaceContainerHighest"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:tint="?attr/colorOutline"
            tools:src="@drawable/ic_category_grocery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Buy bread" />

            <TextView
                android:id="@+id/doneAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Done · 9:42 AM" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/doneCheck"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:checked="true"
            app:buttonTint="?attr/colorOutline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
