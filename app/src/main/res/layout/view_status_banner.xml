<?xml version="1.0" encoding="utf-8"?>
<!-- Content of StatusBanner (screens 05, 09, 16): icon, title, body, optional close, one action. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bannerIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_banner_location_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/bannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="@string/banner_background_title" />

            <TextView
                android:id="@+id/bannerBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="@string/banner_background_body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/banner_dismiss"
            app:icon="@drawable/ic_close"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- Error tone: filled error button. Info tone: text button. Only one is visible. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bannerActionFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/space_s"
        tools:text="@string/banner_fix" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bannerActionText"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:visibility="gone" />
</merge>
